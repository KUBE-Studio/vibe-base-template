# Public origin of the app (better-auth derives its baseURL from this)
ORIGIN="http://localhost:5173"

# Postgres connection string
DATABASE_URL="postgres://app:app@localhost:5432/app"

# Session secret for better-auth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Brevo transactional email (verification, password reset, approval mails)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# Google OAuth login via better-auth
# Redirect URI: {ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
