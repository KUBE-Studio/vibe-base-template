{
	"name": "vibe-base-template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun test src",
		"knip": "knip",
		"verify": "bun run lint && bun run check && bun run test && bun run knip",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:push": "drizzle-kit push --config drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts --name",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"db:studio": "drizzle-kit studio",
		"make-admin": "bun scripts/make-admin.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@getbrevo/brevo": "^6.2.0",
		"@lucide/svelte": "^1.82.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@trpc/client": "^11.31.6",
		"@trpc/server": "^11.31.6",
		"@types/bun": "^1.4.5",
		"@types/node": "^22",
		"@types/ws": "^8.18.2",
		"better-auth": "^1.7.28",
		"bits-ui": "^2.22.0",
		"dompurify": "^3.5.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"knip": "^6.48.0",
		"marked": "^18.3.0",
		"postgres": "^4.1.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"superjson": "^2.2.7",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-hot-french-toast": "^4.1.2",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^6",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.4.0",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	}
}
